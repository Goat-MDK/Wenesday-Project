# =========================================================================
# E-Sale Management System - Environment Configuration
# =========================================================================

# --- Database Connection (Neon Serverless PostgreSQL) ---
# Paste your Neon Connection URI below. 
# Make sure to include "?sslmode=require" for secure serverless connections.
# Example: postgresql://username:password@ep-cool-name-123456.us-east-2.aws.neon.tech/neondb?sslmode=require
DATABASE_URL=postgresql://neondb_owner:your_neon_password@ep-your-endpoint.us-east-2.aws.neon.tech/neondb?sslmode=require

# (Note: If DATABASE_URL is left empty or omitted, the system gracefully falls back to local SQLite 'esale_dev.db' for instant testing)

# --- Application Settings ---
PROJECT_NAME=E-Sale Management System
DEBUG=True
DEFAULT_TAX_RATE=0.05
LOW_STOCK_DEFAULT_THRESHOLD=10
CURRENCY_SYMBOL=$

# --- Frontend API Connection ---
API_BASE_URL=http://127.0.0.1:8000/api/v1
